{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // Inside outDir: Nest deletes dist on every start, so the incremental record goes with it
    // (outside dist it says "up to date" and nothing is emitted; TypeScript 6 default location).
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "drizzle.config.ts"]
}
