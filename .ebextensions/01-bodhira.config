# Elastic Beanstalk settings for the API (see DEPLOY.md). Secrets are set on the
# environment (console or `eb setenv`), never in this file.
files:
  # Amazon RDS certificate authorities, so DATABASE_URL can use sslmode=verify-full.
  "/etc/pki/tls/certs/rds-global-bundle.pem":
    mode: "000644"
    owner: root
    group: root
    source: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem

option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8080
    NODE_EXTRA_CA_CERTS: /etc/pki/tls/certs/rds-global-bundle.pem
  aws:elasticbeanstalk:environment:
    EnvironmentType: LoadBalanced
    LoadBalancerType: application
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 5
  aws:autoscaling:trigger:
    MeasureName: CPUUtilization
    Unit: Percent
    UpperThreshold: 60
    LowerThreshold: 25
  aws:elasticbeanstalk:environment:process:default:
    # No database call, so a database blip doesn't take every instance out.
    HealthCheckPath: /api/v1/ping
    DeregistrationDelay: 30
  aws:elbv2:loadbalancer:
    IdleTimeout: 120
  aws:elasticbeanstalk:command:
    DeploymentPolicy: RollingWithAdditionalBatch
    BatchSizeType: Fixed
    BatchSize: 1
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
  # Instance logs (the app's stdout included) to CloudWatch Logs. 30 days is a
  # default to confirm (DEPLOY.md section 7); logs outlive the environment.
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    RetentionInDays: 30
    DeleteOnTerminate: false
