NODE_ENV=development
PORT=4000
# Role of this process: WEB (default) = the HTTP API (Beanstalk), WORKER = the
# background-job worker (PM2 on the worker host, needs REDIS_URL). Anything else refuses to start.
APP_TYPE=WEB
# The one secret of the API, the worker and the web app (32+ random bytes, the same value
# everywhere): openssl rand -base64 32. Required in production; unset locally means built-in
# development keys. Each use gets its own key derived from it: encrypting the secrets saved
# in the admin panel, signing private-file links, and the X-Proxy-Secret the web app sends.
# Changing it: set it everywhere at once and re-enter the panel's secrets.
# With it set, every request needs the X-Proxy-Secret (set the same APP_SECRET in the web app).
APP_SECRET=
# PostgreSQL (this app's own database; schema in src/db/schema.ts, migrations in drizzle/).
DATABASE_URL="postgres://user:password@127.0.0.1:5432/bodhira"
# Proxies whose X-Forwarded-For is believed (Express "trust proxy"): the web
# server forwards each visitor's IP. Default loopback; set the web server's address in production.
TRUST_PROXY=loopback
# Redis on the worker host (DEPLOY.md section 4): shared rate-limit counters and the
# background-job queue (BullMQ). With it the API only enqueues jobs (emails, invoice
# PDFs, notifications, VdoCipher imports and deletes) and `npm run start:worker` runs
# them. Unset (development, tests, one box): counters in memory, jobs run inline.
REDIS_URL=
# Worker only: jobs run at once (default 5).
WORKER_CONCURRENCY=
# Key prefix of the job queue (default bodhira; the e2e tests use their own).
BULLMQ_PREFIX=
# PostgreSQL connections per process: 10 per web instance, 5 on the worker (>= WORKER_CONCURRENCY).
# (max web instances + 1) x this + the worker's must stay under the pooler's client limit (DEPLOY.md §3).
DB_POOL_MAX=10
# Comma-separated origins allowed to call the API (the Next.js web app).
CORS_ORIGINS=http://localhost:3000

# Where notification links point (the Next.js web app).
WEB_URL=http://localhost:3000

# File uploads. "r2" in production (Cloudflare R2; credentials and buckets in the panel),
# "local" for development.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=storage/uploads
# Public base of this API, used for local-driver file URLs.
PUBLIC_URL=http://localhost:4000
# Local driver: private files (invoices, and private uploads served at /files/* by signed link).
LOCAL_PRIVATE_DIR=storage/private

FILES_BASE_URL=
# Link lifetime in seconds (default 1800, max 86400).
FILE_URL_TTL=1800
# files:make-private (cut-over only): the legacy site origin of absolute URLs, and a local
# copy of the legacy files for the local driver.
LEGACY_FILES_DIR=
LEGACY_FILES_ORIGIN=

# Demo checkout (no payment) is refused when NODE_ENV=production unless this is 1. Leave unset in production.
BILLING_DEMO=

# Reported by GET /health, as legacy's config('app.name') and app()->environment().
APP_NAME=Bodhira
APP_ENV=production

# Test-only knobs, leave unset in production (tests point them at local stubs).
# R2_ENDPOINT=
# VDOCIPHER_API_BASE=
# MSG91_API_BASE=
# ANTHROPIC_BASE_URL=
