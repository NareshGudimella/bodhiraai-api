NODE_ENV=development
PORT=4000
# Role of this process: WEB (default) = the HTTP API (Beanstalk), WORKER = the
# background-job worker (PM2 on the worker host, needs REDIS_URL). Anything else refuses to start.
APP_TYPE=WEB
# PostgreSQL (this app's own database; schema in src/db/schema.ts, migrations in drizzle/).
DATABASE_URL="postgres://user:password@127.0.0.1:5432/bodhira"
# Proxies whose X-Forwarded-For is believed (Express "trust proxy"): the web
# server forwards each visitor's IP. Default loopback; set the web server's address in production.
TRUST_PROXY=loopback
# Behind Cloudflare: the edge Worker and the web server send the visitor's IP in
# X-Client-IP with this shared secret (same value in both). Unset locally.
# Production refuses to start without it.
PROXY_SECRET=
# Redis on the worker host (DEPLOY.md section 4): shared rate-limit counters and the
# background-job queue (BullMQ). With it the API only enqueues jobs (emails, invoice
# PDFs, notifications, VdoCipher imports and deletes) and `npm run start:worker` runs
# them. Unset (development, tests, one box): counters in memory, jobs run inline.
REDIS_URL=
# Worker only: jobs run at once (default 5).
WORKER_CONCURRENCY=
# Key prefix of the job queue (default bodhira; the e2e tests use their own).
BULLMQ_PREFIX=
# PostgreSQL connections per instance (instances x this < the database's limit).
DB_POOL_MAX=10
# Comma-separated origins allowed to call the API (the Next.js web app).
CORS_ORIGINS=http://localhost:3000

# Where notification links point (the Next.js web app).
WEB_URL=http://localhost:3000

# Provider credentials (R2, MSG91 SMS, payment gateways, Anthropic, VdoCipher, SMTP) are
# not set here. Set them in the Super Admin panel (Integrations, Mail settings); they are
# stored encrypted in the database. A provider with nothing saved stays off (as in
# production). To copy old values over once: `npm run settings:import-env -- --apply` (a dry run without it).
# Encrypts the saved secrets (AES-256-GCM): 32 bytes as base64 or 64 hex characters,
# openssl rand -base64 32. Required in production; development uses a built-in key when
# unset. Changing it makes the saved secrets unreadable (enter them again).
MAIL_SETTINGS_KEY=

# File uploads. "r2" in production (Cloudflare R2; credentials and buckets in the panel),
# "local" for development.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=storage/uploads
# Public base of this API, used for local-driver file URLs.
PUBLIC_URL=http://localhost:4000
# Local driver: private files (invoices, and private uploads served at /files/* by signed link).
LOCAL_PRIVATE_DIR=storage/private

# Signed links for private files (security: not in legacy): <FILES_BASE_URL>/files/<key>?exp&sig.
# Production refuses to start without FILE_URL_SECRET (32+ chars, the same value as the
# edge Worker's FILE_URL_SECRET) and FILES_BASE_URL (the site origin). Locally a dev
# secret is used and FILES_BASE_URL defaults to PUBLIC_URL.
FILE_URL_SECRET=
FILES_BASE_URL=
# Link lifetime in seconds (default 1800, max 86400).
FILE_URL_TTL=1800
# files:make-private (cut-over only): the legacy site origin of absolute URLs, and a local
# copy of the legacy files for the local driver.
LEGACY_FILES_DIR=
LEGACY_FILES_ORIGIN=

# Demo checkout (no payment) is refused when NODE_ENV=production unless this is 1. Leave unset in production.
BILLING_DEMO=

# Reported by GET /health, as legacy's config('app.name') and app()->environment().
APP_NAME=Bodhira
APP_ENV=production
# Reported by the deep GET /health as checks.cache.driver (legacy's CACHE_STORE). The
# check itself always uses the database `cache` table; leave unset ("database").
CACHE_STORE=

# CLI only (`npm run user:create-super-admin`): the new super admin's password; asked for
# on the terminal when unset. Never leave it set on a server.
SUPER_ADMIN_PASSWORD=

# Test-only knobs, leave unset in production (tests point them at local stubs).
# R2_ENDPOINT=
# VDOCIPHER_API_BASE=
# MSG91_API_BASE=
# ANTHROPIC_BASE_URL=
