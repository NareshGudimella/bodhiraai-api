NODE_ENV=development
PORT=4000
# PostgreSQL (this app's own database; schema in src/db/schema.ts, migrations in drizzle/).
DATABASE_URL="postgres://user:password@127.0.0.1:5432/bodhira"
# Proxies whose X-Forwarded-For is believed (Express "trust proxy"): the web
# server forwards each visitor's IP. Default loopback; set the web server's address in production.
TRUST_PROXY=loopback
# Behind Cloudflare: the edge Worker and the web server send the visitor's IP in
# X-Client-IP with this shared secret (same value in both). Unset locally.
PROXY_SECRET=
# Shared rate-limit counters when several instances run (Redis on the EC2 host).
# Unset: counters in memory, per instance.
REDIS_URL=
# PostgreSQL connections per instance (instances x this < the database's limit).
DB_POOL_MAX=10
# Comma-separated origins allowed to call the API (the Next.js web app).
CORS_ORIGINS=http://localhost:3000

# Where notification links point (the Next.js web app).
WEB_URL=http://localhost:3000
# AI tutor. Without a key the tutor uses the canned fallback replies (same as legacy).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=1024
AI_DAILY_TOKEN_LIMIT=5000

# File uploads. "r2" in production (Cloudflare R2), "local" for development.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=storage/uploads
# Public base of this API, used for local-driver file URLs.
PUBLIC_URL=http://localhost:4000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public domain serving the bucket (custom domain or r2.dev URL).
R2_PUBLIC_URL=
# Optional endpoint override (tests point this at MinIO).
R2_ENDPOINT=
# Private bucket for files only the API serves (invoice PDFs). Never the public bucket.
R2_PRIVATE_BUCKET=
# Local driver: private files (not served).
LOCAL_PRIVATE_DIR=storage/private

# Billing (legacy names). Without keys, checkout runs in demo mode.
BILLING_GATEWAY=razorpay
# Demo checkout (no payment) is refused when NODE_ENV=production unless this is 1. Leave unset in production.
BILLING_DEMO=

# Phone OTP sign-in. Off in production unless 1 (no SMS provider exists); on elsewhere unless 0.
OTP_LOGIN_ENABLED=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Outgoing email (password resets, invoices). Normally set in the super admin panel
# (Mail settings, stored in the mail_settings table); the MAIL_* values below are only
# the fallback used while nothing is saved there. "log" writes messages to the log
# (Laravel's default); "smtp" sends them. In production only "smtp" sends.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# "smtps" for implicit TLS (port 465 implies it).
MAIL_SCHEME=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Bodhira
# Encrypts the SMTP password saved in the admin panel (AES-256-GCM). 32 bytes as base64
# or 64 hex characters: openssl rand -base64 32. Required in production to save a
# password; development uses a built-in key when unset. Changing it makes the saved
# password unreadable (save it again).
MAIL_SETTINGS_KEY=

# Reported by GET /health, as legacy's config('app.name') and app()->environment().
APP_NAME=Bodhira
APP_ENV=production

# Secure marketing video (VdoCipher). Without a secret, /video/otp answers 502 "unavailable" (as legacy).
VDOCIPHER_API_SECRET=
VDOCIPHER_VIDEO_ID=
